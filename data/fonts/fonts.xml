<?xml version="1.0" encoding="utf-8"?>
<fonts>
  <!-- Preset fonts that can be used by all themes -->

  <font name="Arial"
        type="truetype"
        file="Arial.ttf" />

  <font name="Arial Unicode"
        type="truetype"
        file_win="arialuni.ttf"
        file_mac="Arial Unicode.ttf" />

  <font name="Unicode Korean"
        type="truetype"
        file_win="malgun.ttf">
    <fallback font="Arial Unicode" />
  </font>
  <font name="Unicode Japanese"
        type="truetype"
        file_win="msjh.ttc"
        file_linux="NotoSansCJK-Regular.ttc">
    <fallback font="Unicode Korean" />
  </font>
  <font name="Unicode"
        type="truetype"
        file_win="Arial.ttf"
        file_mac="Arial Unicode.ttf"
        file_linux="DejaVuSans.ttf">
    <fallback font="Unicode Japanese" size="8" />
  </font>

  <!-- Fusion Pixel Font (https://github.com/TakWolf/fusion-pixel-font, OFL-1.1)
       Pixel bitmap-style TTF with full CJK coverage, so Chinese/Japanese/Korean
       text renders in the same pixel style and size as the UI fonts.
       antialias/hinting disabled to keep the bitmap look crisp. -->
  <font name="Fusion Pixel"
        type="truetype"
        file="fusion-pixel-12px-proportional-zh_hans.ttf"
        antialias="false"
        hinting="false">
    <fallback font="Unicode" size="10" />
  </font>

  <font name="Fusion Pixel Mini"
        type="truetype"
        file="fusion-pixel-10px-proportional-zh_hans.ttf"
        antialias="false"
        hinting="false">
    <fallback font="Unicode" size="8" />
  </font>

  <font name="Aseprite"
        type="spritesheet"
        descent="2"
        file="aseprite_font.png">
    <fallback font="Unicode" size="14" />
  </font>

  <font name="Aseprite Mini"
        type="spritesheet"
        descent="1"
        file="aseprite_mini.png">
    <fallback font="Unicode" size="10" />
  </font>

</fonts>
